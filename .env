# Environment Variables for Development
# DO NOT COMMIT THIS FILE WITH REAL SECRETS TO VERSION CONTROL

# JWT Configuration (Required - minimum 32 characters)
JWT_SECRET=MySuperSecretKeyForJWTTokenGenerationThatIsAtLeast32CharactersLongAndSecureForDevelopment

# Stripe Configuration (Optional for development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# H2 Console (Set to 'true' to enable H2 database console in development)
H2_CONSOLE_ENABLED=true
